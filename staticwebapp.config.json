{
  "routes": [
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/privacy", "redirect": "/privacy/", "statusCode": 302 },
    { "route": "/privacy/", "rewrite": "/privacy/index.html" },
    { "route": "/terms", "redirect": "/terms/", "statusCode": 302 },
    { "route": "/terms/", "rewrite": "/terms/index.html" }
  ],
  "responseOverrides": { "404": { "rewrite": "/index.html", "statusCode": 404 } },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
